<Page
    x:Class="Meteion.Toolkit.WPF.SampleApp.Views.StatefulContainerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:meteion="http://wpf.meteion.ca/winfx/xaml"
    xmlns:viewmodels="clr-namespace:Meteion.Toolkit.WPF.SampleApp.ViewModels"
    Title="StatefulContainer"
    d:DataContext="{d:DesignInstance Type=viewmodels:StatefulContainerPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Overriding the loading visual only needs a DataTemplate; the default error panel is kept below.  -->
        <DataTemplate x:Key="CustomLoadingTemplate">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                Text="Fetching... (custom loading template)" />
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Margin="0,0,5,10" Command="{Binding LoadCommand}" Content="Load (succeeds)" />
            <Button Margin="0,0,5,10" Command="{Binding LoadAndFailCommand}" Content="Load (fails, then Retry works)" />
            <Button Margin="0,0,5,10" Command="{Binding GoBackCommand}" Content="Go Back" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3">
            <GroupBox Margin="0,0,5,0" Header="Replace (default, no Retry button)">
                <meteion:StatefulContainer State="{Binding State}">
                    <TextBlock Text="{Binding Result}" />
                </meteion:StatefulContainer>
            </GroupBox>

            <GroupBox Margin="0,0,5,0" Header="Overlay + Retry">
                <meteion:StatefulContainer
                    Mode="Overlay"
                    RetryCommand="{Binding LoadCommand}"
                    State="{Binding State}">
                    <TextBlock Text="{Binding Result}" />
                </meteion:StatefulContainer>
            </GroupBox>

            <GroupBox Header="Custom loading template + Retry">
                <meteion:StatefulContainer
                    LoadingTemplate="{StaticResource CustomLoadingTemplate}"
                    RetryCommand="{Binding LoadCommand}"
                    RetryContent="Try again"
                    State="{Binding State}">
                    <TextBlock Text="{Binding Result}" />
                </meteion:StatefulContainer>
            </GroupBox>
        </UniformGrid>
    </Grid>
</Page>
