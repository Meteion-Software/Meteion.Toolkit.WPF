<Page
    x:Class="Meteion.Toolkit.WPF.SampleApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Meteion.Toolkit.WPF.SampleApp.Views"
    xmlns:lx="http://wpf.meteion.ca/winfx/xaml/localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Meteion.Toolkit.WPF.SampleApp.ViewModels"
    Title="{lx:LocalizedValue HomePage_WelcomeMessage}"
    d:DataContext="{d:DesignInstance Type=viewmodels:HomePageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="{lx:LocalizedValue HomePage_WelcomeMessage}" />
            <TextBlock>
                <Run Text="{lx:LocalizedValue ScopeID}" /><Run Text=":" />
                <Run Text="{Binding ScopeId, Mode=OneWay}" />
            </TextBlock>

            <Button
                Margin="5"
                Command="{Binding SwitchLanguageCommand}"
                Content="{lx:LocalizedValue ChangeLanguage}" />

            <Separator Margin="0,15,0,10" />
            <TextBlock
                Margin="0,0,0,10"
                FontWeight="Bold"
                Text="LocalizedValue usage examples" />

            <!--  1. Literal Key, targeting a DependencyProperty (TextBlock.Text).  -->
            <TextBlock FontStyle="Italic" Text="1. Literal Key -&gt; DependencyProperty target:" />
            <TextBlock Margin="0,0,0,10" Text="{lx:LocalizedValue HomePage_WelcomeMessage}" />

            <!--  2. Literal Key, targeting a plain CLR property (Run.Text has no DependencyProperty).  -->
            <TextBlock FontStyle="Italic" Text="2. Literal Key -&gt; plain CLR property target (Run.Text):" />
            <TextBlock Margin="0,0,0,10">
                <Run Text="{lx:LocalizedValue ScopeID}" />
            </TextBlock>

            <!--
                3. KeyBinding, sourcing the key dynamically from a bound view-model property
                (instead of a fixed literal Key), so both the source key and culture changes
                are reflected live.
            -->
            <TextBlock Text="3. KeyBinding -&gt; key chosen from a ComboBox:" FontStyle="Italic" />
            <ComboBox ItemsSource="{Binding AvailableKeys}" SelectedItem="{Binding SelectedKey}"
                      Width="220" HorizontalAlignment="Left" Margin="0,0,0,5" />
            <TextBlock Text="{lx:LocalizedValue KeyBinding={Binding SelectedKey}}" Margin="0,0,0,10" />

            <!--
                4. KeyBinding inside a DataTemplate: each row resolves its own key from its own
                FeatureItem, demonstrating per-item dynamic keys resolved inside an
                ItemsControl.ItemTemplate (rather than a single, directly-owned DependencyProperty).
            -->
            <TextBlock Text="4. KeyBinding -&gt; per-item key inside a DataTemplate:" FontStyle="Italic" />
            <ItemsControl ItemsSource="{Binding Features}" Margin="0,0,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{lx:LocalizedValue KeyBinding={Binding Key}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>
