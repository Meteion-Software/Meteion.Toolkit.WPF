<Page
    x:Class="Meteion.Toolkit.WPF.SampleApp.Views.DialogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Meteion.Toolkit.WPF.SampleApp.ViewModels"
    Title="Dialogs"
    d:DataContext="{d:DesignInstance Type=viewmodels:DialogsPageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <StackPanel Margin="10">
        <TextBlock FontWeight="Bold" Text="IDialogService (resolved from DI)" />
        <WrapPanel Margin="0,5,0,10">
            <Button Margin="0,0,5,5" Padding="8,2" Command="{Binding OpenFileCommand}" Content="Open file" />
            <Button Margin="0,0,5,5" Padding="8,2" Command="{Binding OpenFilesCommand}" Content="Open files" />
            <Button Margin="0,0,5,5" Padding="8,2" Command="{Binding SaveFileCommand}" Content="Save file" />
            <Button Margin="0,0,5,5" Padding="8,2" Command="{Binding PickFolderCommand}" Content="Pick folder" />
            <Button Margin="0,0,5,5" Padding="8,2" Command="{Binding PickFoldersCommand}" Content="Pick folders" />
        </WrapPanel>

        <TextBlock FontWeight="Bold" Text="Dialog classes directly" />
        <Button
            Margin="0,5,0,10"
            Padding="8,2"
            HorizontalAlignment="Left"
            Command="{Binding OpenFileDirectCommand}"
            Content="OpenFileDialog: read-only choice + FileOk veto" />

        <TextBlock FontWeight="Bold" Text="Result" />
        <TextBox
            MinHeight="80"
            Margin="0,5,0,10"
            IsReadOnly="True"
            Text="{Binding Result, Mode=OneWay}" />

        <Button
            Padding="8,2"
            HorizontalAlignment="Left"
            Command="{Binding GoBackCommand}"
            Content="Go Back" />
    </StackPanel>
</Page>
