<Window
    x:Class="Meteion.Toolkit.WPF.SampleApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Meteion.Toolkit.WPF.SampleApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:meteion="http://wpf.meteion.ca/winfx/xaml"
    Title="Demo Window"
    Width="800"
    Height="450"
    Loaded="Window_Loaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0">
            <Run Text="MainWindowViewModel Scope ID:" />
            <Run Text="{Binding ScopeId}" />
        </TextBlock>

        <Grid Grid.Row="1">
            <Frame
                x:Name="ShellFrame"
                NavigationUIVisibility="Hidden" />

            <meteion:BusyOverlay x:Name="NavigationBusyOverlay" />
        </Grid>
    </Grid>
</Window>
