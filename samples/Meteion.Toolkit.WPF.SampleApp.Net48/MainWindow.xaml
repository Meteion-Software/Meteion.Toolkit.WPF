<Window
    x:Class="Meteion.Toolkit.WPF.SampleApp.Net48.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dialogs - .NET Framework 4.8"
    Width="640"
    Height="480">

    <StackPanel Margin="10">
        <TextBlock FontWeight="Bold" Text="IDialogService (DialogService, created directly)" />
        <WrapPanel Margin="0,5,0,10">
            <Button Margin="0,0,5,5" Padding="8,2" Click="OpenFile_Click" Content="Open file" />
            <Button Margin="0,0,5,5" Padding="8,2" Click="OpenFiles_Click" Content="Open files" />
            <Button Margin="0,0,5,5" Padding="8,2" Click="SaveFile_Click" Content="Save file" />
            <Button Margin="0,0,5,5" Padding="8,2" Click="PickFolder_Click" Content="Pick folder" />
            <Button Margin="0,0,5,5" Padding="8,2" Click="PickFolders_Click" Content="Pick folders" />
        </WrapPanel>

        <TextBlock FontWeight="Bold" Text="Dialog classes directly" />
        <Button
            Margin="0,5,0,10"
            Padding="8,2"
            HorizontalAlignment="Left"
            Click="OpenFileDirect_Click"
            Content="OpenFileDialog: read-only choice + FileOk veto" />

        <TextBlock FontWeight="Bold" Text="Result" />
        <TextBox
            x:Name="ResultBox"
            MinHeight="120"
            Margin="0,5,0,0"
            IsReadOnly="True"
            Text="(no dialog shown yet)" />
    </StackPanel>
</Window>
