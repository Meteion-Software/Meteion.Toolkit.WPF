<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Meteion.Toolkit.WPF.Controls"
    xmlns:converters="clr-namespace:Meteion.Toolkit.WPF.Converters">

    <!--  Default loading visual: a spinning dashed ring. The storyboard only runs while this template is realized.  -->
    <DataTemplate x:Key="Meteion.StatefulContainer.DefaultLoadingTemplate">
        <Ellipse
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
            Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
            StrokeDashArray="4 3"
            StrokeThickness="4">
            <Ellipse.RenderTransform>
                <RotateTransform x:Name="SpinnerRotation" Angle="0" />
            </Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                RepeatBehavior="Forever"
                                Storyboard.TargetName="SpinnerRotation"
                                Storyboard.TargetProperty="Angle"
                                From="0"
                                To="360"
                                Duration="0:0:1" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
    </DataTemplate>

    <!--  Default error visual: a card with a title, the error message, and a Retry button when RetryCommand is set.  -->
    <DataTemplate x:Key="Meteion.StatefulContainer.DefaultErrorTemplate">
        <Border
            MaxWidth="480"
            Margin="16"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Assertive"
            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="1"
            CornerRadius="4"
            TextElement.Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
            <StackPanel>
                <ContentPresenter
                    Content="{Binding ErrorTitle, RelativeSource={RelativeSource AncestorType={x:Type controls:StatefulContainer}}}"
                    TextElement.FontWeight="SemiBold" />
                <TextBlock
                    Margin="0,8,0,0"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />
                <Button
                    Margin="0,12,0,0"
                    Padding="12,4"
                    HorizontalAlignment="Left"
                    Command="{Binding RetryCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:StatefulContainer}}}"
                    CommandParameter="{Binding RetryCommandParameter, RelativeSource={RelativeSource AncestorType={x:Type controls:StatefulContainer}}}"
                    Content="{Binding RetryContent, RelativeSource={RelativeSource AncestorType={x:Type controls:StatefulContainer}}}"
                    Visibility="{Binding RetryCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:StatefulContainer}}, Converter={x:Static converters:VisibleIfNotNullConverter.Instance}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <Style TargetType="{x:Type controls:StatefulContainer}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="LoadingTemplate" Value="{StaticResource Meteion.StatefulContainer.DefaultLoadingTemplate}" />
        <Setter Property="ErrorTemplate" Value="{StaticResource Meteion.StatefulContainer.DefaultErrorTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatefulContainer}">
                    <Grid>
                        <ContentPresenter
                            x:Name="PART_Content"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                        <Border x:Name="PART_StateLayer" Visibility="Collapsed">
                            <ContentPresenter x:Name="PART_StateHost" ContentSource="" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
