<Project>

  <PropertyGroup>
    <RunLocalizationKeyCheck Condition="'$(RunLocalizationKeyCheck)' == ''">true</RunLocalizationKeyCheck>

    <!--
      Un-localized literal check (LOC009/LOC010): flags plain string literals in Text, Content,
      Header, ToolTip, Title, etc. Off by default. MeteionLocalizationLiteralProperties adds
      extra property names (";"-separated) to the built-in list.
    -->
    <MeteionLocalizationCheckLiterals Condition="'$(MeteionLocalizationCheckLiterals)' == ''">false</MeteionLocalizationCheckLiterals>

    <!--
      Severity: every diagnostic is a warning by default. Set
      MeteionLocalizationWarningsAsErrors=true to make all of them (LOC001-LOC006, LOC008-LOC010) errors, or list
      specific codes in MeteionLocalizationErrorCodes (e.g. "LOC003;LOC004"). LOC007 is
      informational and never promoted.
    -->
    <MeteionLocalizationWarningsAsErrors Condition="'$(MeteionLocalizationWarningsAsErrors)' == ''">false</MeteionLocalizationWarningsAsErrors>

    <!--
      NuGet always extracts a restored package's full contents (lib\, build\, etc.) to its
      package-cache folder regardless of the consumer's IncludeAssets/PrivateAssets settings -
      those only filter what gets projected into the consumer's own Reference/copy-local
      items. So this relative lookup finds the assembly reliably even when a consumer (as
      recommended) references this package with IncludeAssets="build;buildTransitive" to keep
      it out of their own compiled/shipped output entirely.
    -->
    <_MeteionLocCheckToolPath Condition="'$(_MeteionLocCheckToolPath)' == ''">$(MSBuildThisFileDirectory)..\lib\net8.0\Meteion.Toolkit.Localization.Check.dll</_MeteionLocCheckToolPath>

    <!--
      Repo-local development fallback: when this file is Import'd directly from source (no
      packed lib\ folder exists alongside it, e.g. this repo's own SampleApp dogfooding it),
      fall back to this repo's own centralized artifacts output. Harmless no-op for real
      package consumers, since that relative path never resolves to anything inside a
      restored nupkg.
    -->
    <_MeteionLocCheckToolPath Condition="!Exists('$(_MeteionLocCheckToolPath)')">$(MSBuildThisFileDirectory)..\..\..\artifacts\bin\Meteion.Toolkit.Localization.Check\$(Configuration.ToLower())\Meteion.Toolkit.Localization.Check.dll</_MeteionLocCheckToolPath>
  </PropertyGroup>

  <Target Name="MeteionLocalizationKeyCheck"
          BeforeTargets="Build"
          Condition="'$(RunLocalizationKeyCheck)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(BuildingProject)' == 'true' and Exists('$(_MeteionLocCheckToolPath)')">
    <PropertyGroup>
      <_MeteionLocCheckArgs>&quot;$(MSBuildProjectDirectory)&quot; --assembly-name &quot;$(AssemblyName)&quot; --root-namespace &quot;$(RootNamespace)&quot;</_MeteionLocCheckArgs>
      <_MeteionLocCheckArgs Condition="'$(MeteionLocalizationWarningsAsErrors)' == 'true'">$(_MeteionLocCheckArgs) --warnaserror</_MeteionLocCheckArgs>
      <_MeteionLocCheckArgs Condition="'$(MeteionLocalizationErrorCodes)' != ''">$(_MeteionLocCheckArgs) --error &quot;$(MeteionLocalizationErrorCodes)&quot;</_MeteionLocCheckArgs>
      <_MeteionLocCheckArgs Condition="'$(MeteionLocalizationCheckLiterals)' == 'true'">$(_MeteionLocCheckArgs) --check-literals</_MeteionLocCheckArgs>
      <_MeteionLocCheckArgs Condition="'$(MeteionLocalizationCheckLiterals)' == 'true' and '$(MeteionLocalizationLiteralProperties)' != ''">$(_MeteionLocCheckArgs) --literal-property &quot;$(MeteionLocalizationLiteralProperties)&quot;</_MeteionLocCheckArgs>
    </PropertyGroup>

    <!--
      Errors are reported by the tool's own canonical "error LOCxxx:" output lines, which Exec
      logs as build errors - so the tool's exit code is ignored (it would only add a redundant
      "exited with code 1" error), and ContinueOnError is left at its default so those errors
      actually fail the build rather than being downgraded to warnings.
    -->
    <Exec Command="dotnet exec &quot;$(_MeteionLocCheckToolPath)&quot; $(_MeteionLocCheckArgs)"
          IgnoreExitCode="true"
          StandardOutputImportance="high"
          EchoOff="true" />
  </Target>

</Project>
